---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="w-full max-w-[1920px] h-dvh flex flex-col lg:flex-row gap-0 p-0">
    
    <!-- Image -->
    <div class="flex flex-col justify-start p-0">
		<img 
			src="/assets/home-hero-pam.png" 
			alt="Pamela Maguigad" 
			class="w-[680px] h-auto object-cover" 
		/>
    </div>

    <!-- Content -->
    <div class="w-2/3 flex flex-col justify-center items-start gap-12 p-20">
      
		<img 
			src="/assets/brand-name.svg" 
			alt="Pamela Maguigad" 
			class="w-full max-w-md object-contain" 
		/>

      <!-- Text Content -->
      <div class="w-full flex flex-col gap-8 pl-40">
        <h2 class="text-zinc-900 text-4xl md:text-5xl font-normal leading-tight">
          The idea matters. <br /> So does how it’s made.
        </h2>
        
        <p class="w-full max-w-[600px] text-zinc-900 text-lg md:text-2xl font-light leading-relaxed">
          I work across architecture, visual storytelling, and the web, connecting creative direction with the practical work of design, production, and development.
        </p>
      </div>

    </div>
    
  </section>
</BaseLayout>