---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- Hero Section -->
    <section class="w-full max-w-[1920px] mx-auto flex flex-col md:flex-row gap-0 p-0 overflow-hidden">
        
        <!-- Image Container -->
        <div class="flex flex-col justify-start p-0 w-full md:w-1/2 xl:max-w-[700px] shrink-0 hero-animate-up relative z-10">
            <img 
                src="/assets/home-hero-pam.png" 
                alt="Pamela Maguigad" 
                class="w-full h-[500px] md:h-[1000px] object-cover" 
            />
        </div>

        <!-- Content Container -->
        <div class="w-full flex-1 relative z-30 flex flex-col justify-center items-start gap-12 p-6 sm:p-10 2xl:p-20">
            
            <picture class="absolute top-[-200px] md:top-30 lg:top-50 max-w-full md:pr-6 lg:pr-0 hero-animate-up hero-delay-100">
                <source srcset="/assets/brand-name.svg" media="(min-width: 768px)">
                <img src="/assets/brand-name-white.svg" alt="Company Logo" class="h-36 w-auto md:h-46 max-w-full object-contain">
            </picture>

            <!-- Text Content -->
            <div class="static md:absolute md:top-80 lg:top-105 w-auto flex flex-col gap-8 3xl:pl-40 py-10 sm:py-20 pr-0 md:pr-10">
                <h2 class="hero-animate-up hero-delay-200">
                    Architectural Designer <br /> & Multidisciplinary Creative
                </h2>
                
                <p class="w-full max-w-2xl text-lg md:text-xl text-pretty hero-animate-up hero-delay-300">
                    I work across architecture, visual storytelling, and the web, connecting creative direction with the practical work of design, production, and development.
                </p>
            </div>

        </div>
        
    </section>
</BaseLayout>

<style>
    /* --- Hero Load Animations (Keyframes) --- */
    .hero-animate-up {
        opacity: 0;
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .hero-animate-fade {
        opacity: 0;
        animation: fadeIn 1.2s ease-out forwards;
    }

    .hero-delay-100 { animation-delay: 150ms; }
    .hero-delay-200 { animation-delay: 300ms; }
    .hero-delay-300 { animation-delay: 500ms; }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* --- Scroll Reveal Animations (CSS Transitions) --- */
    .scroll-reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .scroll-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .scroll-delay-100 { transition-delay: 150ms; }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                } else {
                    entry.target.classList.remove("is-visible");
                }
            });
        }, {
            root: null,
            rootMargin: "0px",
            threshold: 0.15
        });

        const revealElements = document.querySelectorAll(".scroll-reveal");
        revealElements.forEach((el) => observer.observe(el));
    });
</script>