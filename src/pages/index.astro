---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- MASTER WRAPPER -->
    <div class="w-full max-w-[1920px] mx-auto relative flex flex-col lg:flex-row overflow-hidden">
        
        <!-- LEFT SIDE: Image (40%) -->
        <div class="w-full lg:w-[40%] relative z-10">
            <div class="h-[50vh] lg:h-[100svh] w-full hero-fade-in">
                <img 
                    src="/assets/home-hero-pam.png" 
                    alt="Pamela Maguigad" 
                    class="w-full h-full object-cover" 
                />
            </div>
        </div>

        <!-- RIGHT SIDE: Content Column (60%) -->
        <div class="w-full lg:w-[60%] flex flex-col relative z-30">
            
            <!-- Hero Section -->
            <section class="min-h-[50vh] lg:min-h-[100svh] flex flex-col justify-center items-start gap-12 p-8 lg:p-20 xl:pr-30 relative">
                
                <picture class="static lg:absolute lg:top-50 max-w-full hero-fade-in hero-delay-100">
                    <source srcset="/assets/brand-name.svg" media="(min-width: 768px)">
                    <img src="/assets/brand-name-white.svg" alt="Company Logo" class="h-36 w-auto md:h-46 max-w-full object-contain">
                </picture>

                <!-- Text Content with Mask Reveal -->
                <div class="static lg:absolute lg:top-105 w-auto flex flex-col gap-8 py-10 lg:py-0 pr-0 md:pr-10">
                    
                    <!-- Mask Wrapper -->
                    <div class="overflow-hidden py-1">
                        <h2 class="hero-mask-slide hero-delay-200">
                            Architectural Designer <br /> & Multidisciplinary Creative
                        </h2>
                    </div>
                    
                    <!-- Mask Wrapper -->
                    <div class="overflow-hidden py-1">
                        <p class="w-full max-w-2xl text-lg md:text-xl text-pretty hero-mask-slide hero-delay-300">
                            I work across architecture, visual storytelling, and the web, connecting creative direction with the practical work of design, production, and development.
                        </p>
                    </div>
                </div>

            </section>

        </div>

    </div>
</BaseLayout>

<style>
    /* --- Pinterest-Style Mask Reveal Animations --- */
    .hero-mask-slide {
        transform: translateY(110%);
        opacity: 0;
        animation: maskSlideUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .hero-fade-in {
        opacity: 0;
        animation: fadeIn 1.2s ease-out forwards;
    }

    .hero-delay-100 { animation-delay: 150ms; }
    .hero-delay-200 { animation-delay: 300ms; }
    .hero-delay-300 { animation-delay: 450ms; }

    @keyframes maskSlideUp {
        0% { transform: translateY(110%); opacity: 0; }
        1% { opacity: 1; } /* Instantly visible but hidden by overflow */
        100% { transform: translateY(0); opacity: 1; }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>