---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- Hero Section -->
    <section class="w-full max-w-[1920px] mx-auto flex flex-col md:flex-row gap-0 p-0">
        
        <!-- Image Container -->
        <div class="flex flex-col justify-start p-0 w-full md:w-1/2 xl:max-w-[700px] shrink-0">
            <img 
                src="/assets/home-hero-pam.png" 
                alt="Pamela Maguigad" 
                class="w-full h-[500px] md:h-[1000px] object-cover" 
            />
        </div>

        <!-- Content Container -->
        <div class="w-full flex-1 relative flex flex-col justify-center items-start gap-12 p-6 sm:p-10 2xl:p-20">
            
            <picture class="absolute top-[-200px] md:top-30 lg:top-50 max-w-full md:pr-6 lg:pr-0">
                <source srcset="/assets/brand-name.svg" media="(min-width: 768px)">
                <img src="/assets/brand-name-white.svg" alt="Company Logo" class="h-36 w-auto md:h-46 max-w-full object-contain">
            </picture>

            <!-- Text Content -->
            <div class="static md:absolute md:top-80 lg:top-105 w-auto flex flex-col gap-8 3xl:pl-40 py-10 sm:py-20 pr-0 md:pr-10">
                <h2 class="">
                    Architectural Designer <br /> & Multidisciplinary Creative
                </h2>
                
                <p class="w-full max-w-2xl text-lg md:text-xl text-pretty">
                    I work across architecture, visual storytelling, and the web, connecting creative direction with the practical work of design, production, and development.
                </p>
            </div>

        </div>
        
    </section>
</BaseLayout>