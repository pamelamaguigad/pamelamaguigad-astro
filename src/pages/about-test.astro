---
import BaseLayout from '../layouts/BaseLayoutTest.astro';
---

<BaseLayout>
    
    <!-- INVISIBLE BOUNDING BOX FOR FIXED ELEMENTS -->
    <div class="fixed inset-0 w-full max-w-[1920px] mx-auto px-6 md:px-12 xl:px-16 2xl:px-20 pointer-events-none z-50">
    
        <!-- Fixed Navigation Dots -->
        <nav class="absolute top-1/2 -translate-y-1/2 flex flex-col gap-4 pointer-events-auto">
            <button data-index="0" class="nav-dot w-2 h-2 rounded-full bg-brand-black/20 transition-all duration-300 active-dot" aria-label="Go to Hero"></button>
            <button data-index="1" class="nav-dot w-2 h-2 rounded-full bg-brand-black/20 transition-all duration-300" aria-label="Go to Who I Am"></button>
            <button data-index="2" class="nav-dot w-2 h-2 rounded-full bg-brand-black/20 transition-all duration-300" aria-label="Go to What I Do"></button>
            <button data-index="3" class="nav-dot w-2 h-2 rounded-full bg-brand-black/20 transition-all duration-300" aria-label="Go to Away From The Desk"></button>
            <button data-index="4" class="nav-dot w-2 h-2 rounded-full bg-brand-black/20 transition-all duration-300" aria-label="Go to CTA"></button>
        </nav>

        <!-- Fixed Flip Number Counter -->
        <div class="absolute top-20 lg:top-60 h-[1.2em] overflow-hidden text-lg text-brand-black/30 font-medium font-header leading-tight pointer-events-auto">
            <div id="section-counter" class="flex flex-col transition-transform duration-1000 ease-in-out-expo">
                <div class="h-[1.2em]">01</div>
                <div class="h-[1.2em]">02</div>
                <div class="h-[1.2em]">03</div>
                <div class="h-[1.2em]">04</div>
                <div class="h-[1.2em]">05</div>
            </div>
        </div>

    </div>

    <!-- MASTER WRAPPER -->
    <div class="w-full max-w-[1920px] mx-auto relative flex flex-col lg:flex-row">
        
        <!-- LEFT SIDE: Scrollable Content Column -->
        <div class="w-full lg:w-[60%] flex flex-col pl-16 lg:pl-0">
            
            <!-- Hero Section -->
            <section id="hero" class="scroll-section min-h-[100svh] relative z-30 flex flex-col justify-center gap-10 p-8 lg:p-20 xl:pl-50">
                <h1 class="leading-[90%] hero-animate-up">
                all about Pam
                </h1>
                <h2 class="hero-animate-up hero-delay-100">
                    I shape the story.<br/>Then I make it happen.
                </h2>
            </section>

            <!-- Who I Am Section -->
            <section id="who-i-am" class="scroll-section min-h-svh relative z-30 flex flex-col justify-start p-8 lg:p-20">
                <article class="w-full flex flex-col justify-start items-start gap-12 max-w-120 mt-40 ml-30">
                    <h2 class="scroll-reveal text-lg text-brand-black/30">Who I Am</h2>
                    <div class="hover-text-container flex flex-col gap-6 scroll-reveal scroll-delay-100">
                        <p class="lg:text-2xl text-brand-black font-google-sans leading-[160%]">
                            Hi, I’m Pam, an <span class="keyword">architectural designer</span> and <span class="keyword">multidisciplinary creative</span> based in Hong Kong. My work spans across <span class="keyword">architecture</span>, <span class="keyword">visual storytelling</span>, and the <span class="keyword">web</span>. I’m interested in <span class="keyword">how people experience things</span>, how they move through a place, understand an idea, or find their next step on a website.
                        </p>
                        <p class="lg:text-2xl text-brand-black font-google-sans leading-[160%]">
                            Architecture is the foundation of how I think. It has taught me to connect the bigger picture with the smallest details, work through constraints, and bring different perspectives together. That same curiosity takes me into film, visual identity, and web development—not as separate interests, but as different ways to give an idea form.
                        </p>
                    </div>
                </article>
            </section>

            <!-- What I Do Section -->
            <section id="what-i-do" class="scroll-section min-h-svh relative z-30 flex flex-col justify-start p-8 lg:p-20">
                <article class="w-full flex flex-col justify-start items-start gap-12 max-w-120 mt-40 ml-30">
                    <h2 class="scroll-reveal text-lg text-brand-black/30">What I Do</h2>
                    <div class="hover-text-container flex flex-col gap-6 scroll-reveal scroll-delay-100">
                        <p class="lg:text-2xl text-brand-black font-google-sans leading-[160%]">At my current professional practice, I work on commercial and mixed-use architecture, including large-scale luxury retail developments. My role combines design development, coordination, and visual communication.</p>
                        <p class="lg:text-2xl text-brand-black font-google-sans leading-[160%]">My work also extends into the stories around those spaces. I’ve directed and produced architectural pitch films and helped develop exhibition concepts into physical installations through supplier and organiser coordination.</p>
                        <p class="lg:text-2xl text-brand-black font-google-sans leading-[160%]">Alongside architecture, I design and build for the web. For my recent web project, I brought visual identity, copy, website design, and development together in a live multilingual website.</p>
                    </div>
                </article>
            </section>

            <!-- Away From The Desk Section -->
            <section id="away-from-desk" class="scroll-section min-h-svh relative z-30 flex flex-col justify-start p-8 lg:p-20">
                <article class="w-full flex flex-col justify-start items-start gap-12 max-w-120 mt-40 ml-30">
                    <h2 class="scroll-reveal text-lg text-brand-black/30">Away From The Desk</h2>
                    <div class="max-w-3xl flex flex-col gap-4 scroll-reveal scroll-delay-100">
                        <p class="lg:text-2xl text-brand-black font-google-sans leading-[160%]">Making time away from the screen keeps life balanced. I’m a fitness enthusiast and runner, and I’m happiest when there’s a trail or mountain in the plan. I’ve taken part in the MoonTrekker night race, summited Mount Kinabalu, and done volunteer work in the mountains of Nepal.</p>
                        <p class="lg:text-2xl text-brand-black font-google-sans leading-[160%]">Travel is another constant interest. I like exploring how cities fit together, noticing the buildings and everyday spaces that give a place its character, and experiencing different cultures beyond the itinerary.</p>
                        <p class="lg:text-2xl text-brand-black font-google-sans leading-[160%]">I’m also an avid language learner, currently working towards C1 French from B2. Between design, travel, and languages, there’s always something new to understand.</p>
                    </div>
                </article>
            </section>

            <!-- CTA Section -->
            <section id="cta" class="scroll-section min-h-[100svh] relative z-30 flex flex-col justify-center p-8 lg:p-20 xl:pl-50 overflow-clip">
                <p class="self-stretch text-left justify-start text-zinc-900 text-[28px] sm:text-[36px] md:text-[40px] font-normal font-header leading-tight">See how this translates into my work.</p>
                <p class="self-stretch text-left justify-start text-zinc-900 text-[28px] sm:text-[36px] md:text-[40px] font-medium font-header underline leading-tight"><a href="/cv" class="hover:text-brand-pink transition-colors">View my experience</a></p>
            </section>

        </div>

        <!-- RIGHT SIDE: Sticky Image Track -->
        <div class="w-full lg:w-[40%] relative">
            <!-- This container sticks to the top of the screen while the left side scrolls -->
            <div class="lg:sticky lg:top-0 h-[50vh] lg:h-[100svh] w-full bg-gray-200">
                <img src="/assets/about-hero-pam.png" alt="Pamela Maguigad" class="w-full h-full object-cover" />
            </div>
        </div>

    </div>
    <!-- END MASTER WRAPPER -->

</BaseLayout>

<style>
    /* Active state for the dots */
    .active-dot {
        background-color: #18181b; /* zinc-900 */
        transform: scale(1.2);
    }

    /* Custom Easing for Flip Clock */
    .ease-in-out-expo {
        transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* --- Hero Load Animations --- */
    .hero-animate-up { opacity: 0; animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .hero-animate-fade { opacity: 0; animation: fadeIn 1.2s ease-out forwards; }
    .hero-delay-100 { animation-delay: 150ms; }
    .hero-delay-200 { animation-delay: 300ms; }
    .hero-delay-300 { animation-delay: 500ms; }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* --- Scroll Reveal Animations --- */
    .scroll-reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .scroll-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
    .scroll-delay-100 { transition-delay: 150ms; }
    
    /* Prevent native smooth scrolling from interfering with our JS */
    html {
        scroll-behavior: auto !important;
    }

</style>

<style is:global>
    /* Smooth transition for all words */
    .hover-word {
        transition: opacity 0.3s ease;
        /* Adding inline-block ensures the browser registers the hover accurately */
        display: inline-block; 
    }

    /* When hovering over the paragraph, dim all normal words */
    .hover-text-container p:hover .hover-word {
        opacity: 0.2;
    }

    /* When hovering over a specific dimmed word, bring it back to full opacity */
    .hover-text-container p .hover-word:hover {
        opacity: 0.2;
    }

    /* Keywords always stay at full opacity */
    .hover-text-container .keyword {
        opacity: 1 !important;
        transition: opacity 0.3s ease;
    }
</style>

<script>
    function initWordHover() {
        const textContainers = document.querySelectorAll('.hover-text-container p');
        
        textContainers.forEach(p => {
            if (p.dataset.wrapped) return;
            p.dataset.wrapped = "true";

            const childNodes = Array.from(p.childNodes);
            let newHTML = '';
            
            childNodes.forEach(node => {
                if (node.nodeType === Node.TEXT_NODE) {
                    const words = node.textContent.split(/(\s+)/); 
                    words.forEach(word => {
                        if (word.trim().length > 0) {
                            newHTML += `<span class="hover-word">${word}</span>`;
                        } else {
                            newHTML += word; 
                        }
                    });
                } else {
                    newHTML += node.outerHTML;
                }
            });
            
            p.innerHTML = newHTML;
        });
    }

    initWordHover();

    document.addEventListener("astro:page-load", () => {
        
        initWordHover();

        // 1. Prevent the browser from natively restoring scroll position on refresh
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }

        const sections = Array.from(document.querySelectorAll('.scroll-section'));
        const dots = document.querySelectorAll('.nav-dot');
        const sectionCounter = document.getElementById('section-counter');
        
        // 2. Retrieve the saved section index from sessionStorage (default to 0 if none exists)
        const savedIndex = sessionStorage.getItem('activeSectionIndex');
        let currentSectionIndex = savedIndex ? parseInt(savedIndex, 10) : 0;
        let isScrolling = false;

        // Ultra-Snappy Easing Function
        function easeInOutExpo(t) {
            return t === 0 ? 0 : t === 1 ? 1 : t < 0.5 ? Math.pow(2, 20 * t - 10) / 2 : (2 - Math.pow(2, -20 * t + 10)) / 2;
        }

        // Custom Smooth Scroll Engine
        function smoothScrollTo(targetIndex, duration = 1200) {
            if (isScrolling || targetIndex < 0 || targetIndex >= sections.length) return;
            
            isScrolling = true;
            currentSectionIndex = targetIndex;
            
            // 3. Save the new index to sessionStorage whenever we scroll
            sessionStorage.setItem('activeSectionIndex', currentSectionIndex.toString());
            
            const targetElement = sections[targetIndex];
            const targetPosition = targetElement.getBoundingClientRect().top + window.scrollY;
            const startPosition = window.scrollY;
            const distance = targetPosition - startPosition;
            let startTime = null;

            function animation(currentTime) {
                if (startTime === null) startTime = currentTime;
                const timeElapsed = currentTime - startTime;
                const progress = Math.min(timeElapsed / duration, 1); 
                
                const easeProgress = easeInOutExpo(progress);
                window.scrollTo(0, startPosition + distance * easeProgress);

                if (timeElapsed < duration) {
                    requestAnimationFrame(animation);
                } else {
                    setTimeout(() => { isScrolling = false; }, 50);
                }
            }
            requestAnimationFrame(animation);
            updateUI(targetIndex);
        }

        // Update Dot UI and Flip Clock
        function updateUI(activeIndex) {
            // Update Dots
            dots.forEach((dot, index) => {
                if (index === activeIndex) {
                    dot.classList.add('active-dot');
                } else {
                    dot.classList.remove('active-dot');
                }
            });

            // Update Flip Clock Counter
            if (sectionCounter) {
                // Translates the container up by 100% of a single number's height per index
                sectionCounter.style.transform = `translateY(-${activeIndex * 1.2}em)`;
            }
        }

        // Intercept Mouse Wheel / Trackpad Scrolling
        window.addEventListener('wheel', (e) => {
            e.preventDefault();
            if (isScrolling) return;

            if (e.deltaY > 0) {
                smoothScrollTo(currentSectionIndex + 1);
            } else if (e.deltaY < 0) {
                smoothScrollTo(currentSectionIndex - 1);
            }
        }, { passive: false });

        // Attach Click Listeners to Dots
        const navButtons = document.querySelectorAll('.nav-dot, .next-btn');
        navButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const targetIndex = parseInt(btn.getAttribute('data-index'));
                smoothScrollTo(targetIndex);
            });
        });

        // Intersection Observer for Text Reveal ONLY
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                const reveals = entry.target.querySelectorAll('.scroll-reveal');
                if (entry.isIntersecting) {
                    reveals.forEach(el => el.classList.add("is-visible"));
                }
            });
        }, { root: null, rootMargin: "0px", threshold: 0.3 });

        sections.forEach((section) => observer.observe(section));
        
        // 4. On initial load, instantly snap to the saved section and update UI
        if (sections[currentSectionIndex]) {
            setTimeout(() => {
                const targetPosition = sections[currentSectionIndex].getBoundingClientRect().top + window.scrollY;
                window.scrollTo(0, targetPosition);
                updateUI(currentSectionIndex);
            }, 10);
        }
    });
</script>