---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- Hero Section -->
    <section class="w-full max-w-[1920px] mx-auto flex flex-col md:flex-row gap-0 p-0 mt-24 md:mt-0 relative overflow-hidden">

        <!-- Content Container (Left) -->
        <!-- ADDED: relative z-30 to keep text above the overlay -->
        <div class="w-full flex-1 relative z-30 flex flex-col justify-center items-start gap-8 lg:gap-14 px-6 py-12 sm:py-16 md:px-12 lg:px-16 lg:py-30 2xl:px-20">
            <h1 class="leading-[90%] hero-animate-up">
                all about Pam
            </h1>
            <h2 class="hero-animate-up hero-delay-100">
                I shape the story.<br/>Then I make it happen.
            </h2>
            
            <!-- Scroll CTA -->
            <div class="mt-8 md:mt-16 hero-animate-fade hero-delay-300">
                <div class="flex flex-col items-start gap-3 text-zinc-600 animate-bounce">
                    <span class="text-sm uppercase tracking-widest font-medium">Scroll to explore</span>
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Image Container (Right) -->
        <!-- ADDED: relative z-10 to push the image behind the overlay -->
        <div class="flex flex-col justify-start p-0 w-full md:w-1/2 xl:max-w-[700px] shrink-0 hero-animate-up hero-delay-200 relative z-10">
            <img 
                src="/assets/about-hero-pam.png" 
                alt="Pamela Maguigad" 
                class="w-full h-[500px] md:h-[1000px] object-cover" 
            />
        </div>

    </section>

    <!-- 3-Column Info Section -->
    <!-- ADDED: relative z-30 to ensure the content below the hero also stays above the background overlay -->
    <section class="w-full max-w-[1920px] relative z-30 flex flex-col 2xl:flex-row gap-10 px-10 md:px-12 lg:px-16 2xl:px-10 py-16 sm:pt-16 sm:pb-24 lg:pt-24 lg:pb-30 2xl:py-24 overflow-hidden">

        <!-- Who I Am -->
        <article class="w-full flex flex-col justify-start items-start gap-12 px-0 2xl:px-10 py-12 sm:py-24 md:py-30 2xl:pt-30 3xl:pt-50">
            <h2 class="scroll-reveal">Who I Am</h2>
            <div class="max-w-170 flex flex-col gap-4 scroll-reveal scroll-delay-100">
                <p>I’m Pam, an architectural designer and multidisciplinary creative based in Hong Kong. My work spans spaces, visual storytelling, and the web. I’m interested in how people experience things: how they move through a place, understand an idea, or find their next step on a website.</p>
                <p>Architecture is the foundation of how I think. It has taught me to connect the bigger picture with the smallest details, work through constraints, and bring different perspectives together. That same curiosity takes me into film, visual identity, and web development—not as separate interests, but as different ways to give an idea form.</p>
            </div>
        </article>

        <!-- What I Do  -->
        <article class="w-full flex flex-col justify-start items-start gap-10 px-0 2xl:px-10 py-12 sm:py-24 md:py-30 2xl:pt-100 3xl:pt-150">
            <h2 class="scroll-reveal">What I Do</h2>
            <div class="max-w-170 flex flex-col gap-4 scroll-reveal scroll-delay-100">
                <p>At my current professional practice, I work on commercial and mixed-use architecture, including large-scale luxury retail developments. My role combines design development, coordination, and visual communication: developing proposals, preparing client presentations, and helping teams move towards clear, considered submissions.</p>
                <p>My work also extends into the stories around those spaces. I’ve directed and produced architectural pitch films and helped develop exhibition concepts into physical installations through supplier and organiser coordination.</p>
                <p>Alongside architecture, I design and build for the web. For my recent web project, I brought visual identity, copy, website design, and development together in a live multilingual website. I enjoy both setting the creative direction and doing the hands-on work that makes it real.</p>
            </div>
        </article>

        <!-- Away From The Desk -->
        <article class="w-full flex flex-col justify-start items-start gap-10 px-0 2xl:px-10 py-12 sm:py-24 md:py-30 2xl:pt-200 3xl:pt-250">
            <h2 class="scroll-reveal">Away From The Desk</h2>
            <div class="max-w-170 flex flex-col gap-4 scroll-reveal scroll-delay-100">
                <p>Making time away from the screen keeps life balanced. I’m a fitness enthusiast and runner, and I’m happiest when there’s a trail or mountain in the plan. I’ve taken part in the MoonTrekker night race, summited Mount Kinabalu, and done volunteer work in the mountains of Nepal.</p>
                <p>Travel is another constant interest. I like exploring how cities fit together, noticing the buildings and everyday spaces that give a place its character, and experiencing different cultures beyond the itinerary.</p>
                <p>I’m also an avid language learner, currently working towards C1 French from B2. Between design, travel, and languages, there’s always something new to understand.</p>
            </div>
        </article>

    </section>

    <!-- CTA Section -->
    <!-- ADDED: relative z-30 here as well -->
    <section class="scroll-reveal w-full max-w-[1920px] relative z-30 flex flex-col gap-3 px-6 md:px-12 lg:px-16 2xl:px-20 py-16 sm:py-24 lg:py-30">
        <p class="self-stretch text-right justify-start text-zinc-900 text-[28px] sm:text-[36px] md:text-[40px] font-normal font-header leading-tight">See how this translates into my work.</p>
        <p class="self-stretch text-right justify-start text-zinc-900 text-[28px] sm:text-[36px] md:text-[40px] font-medium font-header underline leading-tight"><a href="/cv" class="hover:text-brand-pink transition-colors">View my experience ↗</a></p>
    </section>

</BaseLayout>

<style>
    /* --- Hero Load Animations (Keyframes) --- */
    .hero-animate-up {
        opacity: 0;
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .hero-animate-fade {
        opacity: 0;
        animation: fadeIn 1.2s ease-out forwards;
    }

    .hero-delay-100 { animation-delay: 150ms; }
    .hero-delay-200 { animation-delay: 300ms; }
    .hero-delay-300 { animation-delay: 500ms; }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* --- Scroll Reveal Animations (CSS Transitions) --- */
    .scroll-reveal {
        opacity: 0;
        transform: translateY(40px);
        /* The transition handles the actual animation smoothly */
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Class added by JS when element enters viewport */
    .scroll-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Staggering for scroll elements */
    .scroll-delay-100 { transition-delay: 150ms; }
</style>

<script>
    // Lightweight observer just to trigger the CSS transitions
    document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    // Optional: Stop observing once revealed so it doesn't animate out when scrolling past
                    // observer.unobserve(entry.target); 
                } else {
                    // Remove this else block if you only want the animation to happen once
                    entry.target.classList.remove("is-visible");
                }
            });
        }, {
            root: null,
            rootMargin: "0px",
            threshold: 0.15 // Triggers when 15% of the element is visible
        });

        const revealElements = document.querySelectorAll(".scroll-reveal");
        revealElements.forEach((el) => observer.observe(el));
    });
</script>