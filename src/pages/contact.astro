---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <section class="w-full max-w-[1920px] mx-auto flex flex-col gap-0 px-6 lg:px-20 mt-30">
        
        <!-- Page Title -->
        <h1 class="py-20">
            say hello!
        </h1>
        
        <!-- Intro Text -->
        <div class="w-full max-w-3xl flex flex-col gap-8">
            <p class="text-zinc-900 text-xl md:text-3xl font-light font-['Stack_Sans_Text'] leading-relaxed">
                I enjoy exchanging ideas about architecture, design, language learning, and the web.
            </p>
            <p class="text-zinc-900 text-xl md:text-3xl font-light font-['Stack_Sans_Text'] leading-relaxed">
                If something here sparked your curiosity, I’d love to hear from you.
            </p>
        </div>

        <!-- Email Link -->
        <div class="w-full pt-10 md:pt-20 flex justify-start lg:justify-end">
            <a 
                href="mailto:hello@pamelamaguigad.com" 
                class="text-[32px] md:text-[44px] xl:text-[48px] font-medium font-header leading-tight text-brand-pink hover:text-brand-black transition-colors"
            >
                hello@pamelamaguigad.com
            </a>
        </div>
        
    </section>
</BaseLayout>