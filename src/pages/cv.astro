---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <div class="w-full flex flex-col items-center bg-brand-cream overflow-hidden">
        
        <!-- Hero & Intro Section -->
        <section class="w-full max-w-[1920px] px-6 md:px-12 lg:px-16 2xl:px-20 py-16 md:py-24 flex flex-col lg:flex-row justify-between items-start gap-12 lg:gap-8">
            <!-- Left: Title -->
            <div class="flex-1 flex flex-col gap-8">
                <h1>resume</h1>
                <h2>Shaping ideas.<br/>Seeing them through.</h2>
            </div>
            
            <!-- Center: Image -->
            <div class="flex-1 w-full flex justify-center">
                <img 
                    class="w-full max-w-[480px] object-cover" 
                    src="https://placehold.co/528x741" 
                    alt="Pamela Maguigad" 
                />
            </div>

            <!-- Right: Contact & Bio -->
            <div class="flex-1 flex flex-col justify-between h-full gap-16 lg:pt-4">
                <address class="flex flex-col gap-4 not-italic">
                    <a href="https://pamelamaguigad.com" target="_blank" class="flex items-center gap-3 text-brand-black text-[16px] font-light font-body hover:text-brand-pink transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                        pamelamaguigad.com
                    </a>
                    <a href="mailto:hello@pamelamaguigad.com" class="flex items-center gap-3 text-brand-black text-[16px] font-light font-body hover:text-brand-pink transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        hello@pamelamaguigad.com
                    </a>
                    <a href="https://linkedin.com/in/pmaguigad" target="_blank" class="flex items-center gap-3 text-brand-black text-[16px] font-light font-body hover:text-brand-pink transition-colors">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                        pmaguigad
                    </a>
                </address>
                <div class="flex flex-col gap-6">
                    <p>With over nine years of experience bridging the physical and digital worlds, I combine architectural delivery with visual storytelling, digital innovation, and creative direction. My background spans luxury retail, large-scale urban developments, and international exhibitions, giving me a unique foundation in spatial problem-solving and complex project coordination.</p>
                    <p>Today, my work connects high-level design decisions with meticulous, hands-on delivery—whether that means coordinating multidisciplinary teams, directing architectural pitch films, or designing and coding custom web platforms. I am passionate about leveraging this diverse toolkit to drive creative ownership, build intuitive user experiences, and bring forward-thinking products and spaces to life.</p>
                </div>
            </div>
        </section>

        <!-- Professional Experience Section -->
        <section class="w-full max-w-[1920px] px-6 md:px-12 lg:px-16 2xl:px-20 py-16 md:py-24 flex flex-col gap-12 md:gap-16">
            <h2>Professional Experience</h2>
            
            <div class="w-full flex flex-col lg:flex-row gap-12 lg:gap-24">
                <!-- Left Column -->
                <div class="flex-1 flex flex-col gap-8">
                    <hr class="border-brand-black/20" />
                    <div>
                        <h3 class="text-brand-black text-[24px] md:text-[32px] font-normal font-body">Architectural Designer</h3>
                        <p class="text-brand-black text-[20px] md:text-[24px] font-light font-body mt-2">Lead8 — Hong Kong</p>
                    </div>
                    <p class="text-brand-black/40 text-[16px] md:text-[18px] font-light font-body">July 2022 – Present</p>
                    <hr class="border-brand-black/20" />
                    
                    <p class="text-brand-black text-[20px] md:text-[24px] font-light font-body leading-relaxed mt-4">
                        I lead architectural and interior design for high-profile commercial, retail, and mixed-use projects, bridging spatial design with visual storytelling, digital innovation, and client engagement.
                    </p>
                    
                    <div class="flex items-end gap-3 mt-auto pt-12">
                        <span class="text-brand-black text-[32px] font-light font-body">01</span>
                        <span class="text-brand-black text-[20px] font-light font-body mb-1">/</span>
                        <span class="text-brand-black text-[20px] font-light font-body mb-1">05</span>
                    </div>
                </div>
                
                <!-- Right Column -->
                <div class="flex-[1.5] grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
                    <div class="flex flex-col gap-3">
                        <h4 class="text-brand-black text-[16px] font-bold font-body">Visual Storytelling & Pitch Production</h4>
                        <p class="text-brand-black text-[16px] font-light font-body leading-relaxed">Pioneered video production for project pitches within the practice, directing and producing architectural pitch films that elevate the firm's visual narrative and competitive edge.</p>
                    </div>
                    <div class="flex flex-col gap-3">
                        <h4 class="text-brand-black text-[16px] font-bold font-body">International Business Development</h4>
                        <p class="text-brand-black text-[16px] font-light font-body leading-relaxed">Collaborate directly with the Singapore Director to drive global business development, crafting executive-level presentations, expressions of interest, and leading overseas client pitches.</p>
                    </div>
                    <div class="flex flex-col gap-3">
                        <h4 class="text-brand-black text-[16px] font-bold font-body">Major Retail Development Support</h4>
                        <p class="text-brand-black text-[16px] font-light font-body leading-relaxed">Spearhead design coordination and stakeholder communications for large-scale global developments, including a 4.5 million sq ft luxury retail project in Dubai.</p>
                    </div>
                    <div class="flex flex-col gap-3">
                        <h4 class="text-brand-black text-[16px] font-bold font-body">Exhibition & Stakeholder Delivery</h4>
                        <p class="text-brand-black text-[16px] font-light font-body leading-relaxed">Directed design development, supplier coordination, and stakeholder communication for exhibition spaces connected to La Biennale di Venezia 2023.</p>
                    </div>
                    <div class="flex flex-col gap-3">
                        <h4 class="text-brand-black text-[16px] font-bold font-body">Design & Project Coordination</h4>
                        <p class="text-brand-black text-[16px] font-light font-body leading-relaxed">Manage cross-functional team workflows and coordinate complex design deliverables, assuming delegated responsibility for project management, quality review, and critical submission decisions during project-lead absences.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Capabilities & Tools Section -->
        <section class="w-full max-w-[1920px] px-6 md:px-12 lg:px-16 2xl:px-20 py-16 md:py-24 flex flex-col gap-12 md:gap-16">
            <h2>Capabilities & Tools</h2>
            
            <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="w-full p-8 md:p-10 rounded-[40px] border border-brand-black/20 flex flex-col gap-8">
                    <div class="flex items-center gap-4">
                        <div class="w-2 h-2 bg-brand-pink rounded-full shrink-0"></div>
                        <h3 class="text-brand-black text-[16px] font-normal font-body">Architecture & Spatial Design</h3>
                    </div>
                    <p class="text-brand-black text-[18px] md:text-[20px] font-light font-body leading-relaxed">
                        Commercial and luxury retail environments, façade studies, masterplanning, and exhibitions—from concept development to coordinated design outputs.
                    </p>
                    <div class="flex flex-col gap-6 mt-auto">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-4 py-1 rounded-full border border-brand-black/20 text-[14px] md:text-[16px] font-medium font-body">Design Expertise</span>
                            <span class="text-[14px] md:text-[16px] font-medium font-body">Design Development • Spatial Studies • Design Documentation • Exhibition Coordination</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-4 py-1 rounded-full border border-brand-black/20 text-[14px] md:text-[16px] font-medium font-body">Modelling</span>
                            <span class="text-[14px] md:text-[16px] font-medium font-body">AutoCAD • SketchUp • Rhino3D</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-4 py-1 rounded-full border border-brand-black/20 text-[14px] md:text-[16px] font-medium font-body">Visualisation</span>
                            <span class="text-[14px] md:text-[16px] font-medium font-body">D5 Render • Enscape</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="w-full p-8 md:p-10 rounded-[40px] border border-brand-black/20 flex flex-col gap-8">
                    <div class="flex items-center gap-4">
                        <div class="w-2 h-2 bg-brand-pink rounded-full shrink-0"></div>
                        <h3 class="text-brand-black text-[16px] font-normal font-body">Visual Storytelling & Creative Direction</h3>
                    </div>
                    <p class="text-brand-black text-[18px] md:text-[20px] font-light font-body leading-relaxed">
                        Shaping how an idea is communicated through visual narratives, pitch films, presentations, and visual identity.
                    </p>
                    <div class="flex flex-col gap-6 mt-auto">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-4 py-1 rounded-full border border-brand-black/20 text-[14px] md:text-[16px] font-medium font-body">Narrative</span>
                            <span class="text-[14px] md:text-[16px] font-medium font-body">Creative Concepts • Visual Storytelling • Pitch Film Direction • Visual Identity • Copywriting</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-4 py-1 rounded-full border border-brand-black/20 text-[14px] md:text-[16px] font-medium font-body">Presentation</span>
                            <span class="text-[14px] md:text-[16px] font-medium font-body">Photoshop • Illustrator • InDesign • PowerPoint</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-4 py-1 rounded-full border border-brand-black/20 text-[14px] md:text-[16px] font-medium font-body">Motion</span>
                            <span class="text-[14px] md:text-[16px] font-medium font-body">Premiere Pro • After Effects</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="w-full p-8 md:p-10 rounded-[40px] border border-brand-black/20 flex flex-col gap-8">
                    <div class="flex items-center gap-4">
                        <div class="w-2 h-2 bg-brand-pink rounded-full shrink-0"></div>
                        <h3 class="text-brand-black text-[16px] font-normal font-body">Digital & Web Technologies</h3>
                    </div>
                    <p class="text-brand-black text-[18px] md:text-[20px] font-light font-body leading-relaxed">
                        Designing and building websites, bringing together interface design, content, front-end development, and AI-assisted workflows.
                    </p>
                    <div class="flex flex-col gap-6 mt-auto">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-4 py-1 rounded-full border border-brand-black/20 text-[14px] md:text-[16px] font-medium font-body">Design</span>
                            <span class="text-[14px] md:text-[16px] font-medium font-body">Website Structure • Interface Design • Multilingual Websites</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-4 py-1 rounded-full border border-brand-black/20 text-[14px] md:text-[16px] font-medium font-body">Development</span>
                            <span class="text-[14px] md:text-[16px] font-medium font-body">Figma • Astro • Tailwind CSS • HTML5 • CSS3 • JavaScript • Git • GitHub • Netlify</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-4 py-1 rounded-full border border-brand-black/20 text-[14px] md:text-[16px] font-medium font-body">AI</span>
                            <span class="text-[14px] md:text-[16px] font-medium font-body">Nanobanana • Higgsfield</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Education Section -->
        <section class="w-full max-w-[1920px] px-6 md:px-12 lg:px-16 2xl:px-20 py-16 md:py-24 flex flex-col gap-12 md:gap-16">
            <h2>Education</h2>
            
            <div class="w-full max-w-[1000px] flex flex-col gap-12">
                <div class="w-full flex flex-col gap-6">
                    <hr class="border-brand-black/20" />
                    <div>
                        <h3 class="text-brand-black text-[24px] md:text-[32px] font-normal font-body">Bachelor of Applied Science (Architectural Science)</h3>
                        <p class="text-brand-black text-[18px] md:text-[20px] font-light font-body mt-2">Curtin University</p>
                    </div>
                    <p class="text-brand-black/60 text-[14px] md:text-[16px] font-light font-body">2015 – 2017</p>
                </div>
                
                <div class="w-full flex flex-col gap-6">
                    <hr class="border-brand-black/20" />
                    <div>
                        <h3 class="text-brand-black text-[24px] md:text-[32px] font-normal font-body">Higher Diploma in Architectural Studies</h3>
                        <p class="text-brand-black text-[18px] md:text-[20px] font-light font-body mt-2">HKU SPACE</p>
                    </div>
                    <p class="text-brand-black/60 text-[14px] md:text-[16px] font-light font-body">2012 – 2014</p>
                    <hr class="border-brand-black/20" />
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="w-full max-w-[1920px] flex flex-col gap-3 px-6 md:px-12 lg:px-16 2xl:px-20 py-16 sm:py-24 lg:py-30">
            <p class="self-stretch text-right justify-start text-zinc-900 text-[28px] sm:text-[36px] md:text-[40px] font-normal font-header leading-tight">There’s more to me than the project list.</p>
            <p class="self-stretch text-right justify-start text-zinc-900 text-[28px] sm:text-[36px] md:text-[40px] font-medium font-header underline leading-tight"><a href="/cv" class="hover:text-brand-pink transition-colors">More about Pam</a></p>
        </section>

    </div>
</BaseLayout>