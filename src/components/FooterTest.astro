<!-- Superseded: lg:fixed lg:bottom-0 lg:left-0 z-50 -->

<div class="w-full max-w-[1920px] mx-auto p-4 md:p-0 lg:fixed bottom-0">
    
    <footer class="flex flex-col lg:flex-row justify-end lg:justify-between lg:items-center gap-12 lg:gap-8 px-8 py-12 md:px-12 xl:px-16 2xl:px-20 bg-brand-black md:bg-transparent text-white md:text-brand-black rounded-xl md:rounded-none">
        
        <!-- Copyright & Credit -->
        <div class="flex flex-col lg:flex-row gap-2 lg:gap-8 lg:items-center">
            <!-- Logo / Name -->
            <div class="header-animate-down text-brand-black text-base font-bold font-syne uppercase tracking-wide hover:text-brand-pink transition-all duration-300 relative z-50">
                Scroll
            </div>

        </div>

        <!-- Socials -->
        <div class="flex flex-col">
            <p class="md:hidden mb-4 text-sm uppercase tracking-widest opacity-70">Find me on:</p>

            <!-- Social Links -->
            <nav aria-label="Social Media">
                <ul class="flex flex-col md:flex-row flex-wrap justify-start lg:justify-center lg:items-center gap-4 md:gap-8">
                    <li>
                        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-[28px] md:text-base font-medium hover:text-brand-pink transition-colors">
                            LinkedIn
                        </a>
                    </li>
                    <li>
                        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-[28px] md:text-base font-medium hover:text-brand-pink transition-colors">
                            GitHub
                        </a>
                    </li>
                    <li>
                        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[28px] md:text-base font-medium hover:text-brand-pink transition-colors">
                            Instagram
                        </a>
                    </li>
                    <li>
                        <a href="https://pinterest.com" target="_blank" rel="noopener noreferrer" class="text-[28px] md:text-base font-medium hover:text-brand-pink transition-colors">
                            Pinterest
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
        
    </footer>
</div>