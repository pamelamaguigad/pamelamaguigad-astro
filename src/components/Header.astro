<header class="w-full h-24 px-6 md:px-20 py-8 flex justify-between items-center bg-transparent">
  
  <!-- Logo / Name -->
  <a href="/" class="text-black text-base font-bold uppercase tracking-wide hover:opacity-80 transition-opacity">
    Pamela Maguigad
  </a>

  <!-- Navigation -->
  <nav>
    <ul class="flex items-center gap-6 md:gap-8">
      <li>
        <a href="/" class="text-black text-base font-medium uppercase hover:text-gray-500 transition-colors">
          Home
        </a>
      </li>
      <li>
        <a href="/about" class="text-black text-base font-medium uppercase hover:text-gray-500 transition-colors">
          About
        </a>
      </li>
      <li>
        <a href="/cv" class="text-black text-base font-medium uppercase hover:text-gray-500 transition-colors">
          CV
        </a>
      </li>
      <li>
        <a href="/contact" class="text-black text-base font-medium uppercase hover:text-gray-500 transition-colors">
          Contact
        </a>
      </li>

      <!-- Language Switcher -->
      <li class="flex items-center gap-1 ml-2 md:ml-4">
        <button class="text-black text-base font-medium uppercase hover:text-gray-600 transition-colors">
          EN
        </button>
        <span class="text-black/30 text-base font-medium uppercase">/</span>
        <button class="text-black/30 text-base font-medium uppercase hover:text-black transition-colors">
