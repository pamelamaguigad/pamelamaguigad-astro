---
// Astro frontmatter
---

<header class="w-full max-w-[1920px] mx-auto fixed top-0 left-0 right-0 z-100 flex pointer-events-none">
    
    <!-- LEFT 60% CONTAINER -->
    <!-- Added 'relative' here so the absolute logo positions correctly inside it -->
    <div class="w-full lg:w-[60%] px-6 md:px-12 xl:px-16 2xl:px-20 py-12 flex justify-between items-center pointer-events-auto relative">
        
        <!-- Menu Toggle Button -->
        <button id="mobile-menu-button" type="button" class="header-animate-down text-brand-black text-base font-bold uppercase hover:text-brand-pink transition-colors cursor-pointer relative z-100" aria-label="Toggle menu">
            Menu
        </button>

        <!-- Logo / Name -->
        <!-- Added 'absolute left-1/2 -translate-x-1/2' to keep it perfectly centered -->
        <a href="/" class="header-animate-down header-delay-150 text-brand-black text-base font-bold font-syne uppercase tracking-wide hover:text-brand-pink transition-all duration-300 absolute left-1/2 -translate-x-1/2 z-100">
            Pamela Maguigad
        </a>

        <!-- Language Switcher -->
        <div class="header-animate-down header-delay-200 flex items-center gap-1 relative z-100">
            <button class="text-brand-black text-base font-bold uppercase hover:text-brand-pink transition-colors cursor-pointer">
            EN
            </button>
            <span class="text-brand-black/30 text-base font-bold uppercase">/</span>
            <button class="text-brand-black/30 text-base font-bold uppercase hover:text-brand-pink transition-colors cursor-pointer">
            FR
            </button>
        </div>

    </div>
    
    <!-- RIGHT 40% -->
    <div class="hidden lg:block lg:w-[40%] pointer-events-none"></div>

</header>

<!-- Menu Overlay -->
<div id="mobile-overlay" class="fixed inset-0 bg-black/20 backdrop-blur-sm z-90 opacity-0 pointer-events-none transition-opacity duration-600"></div>

<!-- Side Panel -->
<aside id="mobile-panel" class="fixed top-0 left-0 h-screen w-full lg:w-[60%] bg-white shadow-2xl z-90 transform -translate-x-full transition-transform duration-500 ease-in-out flex flex-col justify-center px-12 md:px-24 lg:px-70">
    
    <ul class="flex flex-col gap-8">
        <li class="mobile-link">
            <a href="/" class="text-brand-black text-3xl font-bold uppercase hover:text-brand-pink transition-colors">
            Home
            </a>
        </li>
        <li class="mobile-link">
            <a href="/about" class="text-brand-black text-3xl font-bold uppercase hover:text-brand-pink transition-colors">
            About
            </a>
        </li>
        <li class="mobile-link">
            <a href="/cv" class="text-brand-black text-3xl font-bold uppercase hover:text-brand-pink transition-colors">
            CV
            </a>
        </li>
        <li class="mobile-link">
            <a href="/journal" class="text-brand-black text-3xl font-bold uppercase hover:text-brand-pink transition-colors">
            Journal
            </a>
        </li>
        <li class="mobile-link">
            <a href="/contact" class="text-brand-black text-3xl font-bold uppercase hover:text-brand-pink transition-colors">
            Contact
            </a>
        </li>
        
        <!-- Panel Language Switcher -->
        <li class="mobile-link flex items-center gap-2 mt-4 pt-8 border-t border-gray-200 w-max">
            <button class="text-brand-black text-xl font-bold uppercase hover:text-brand-pink transition-colors cursor-pointer">
            EN
            </button>
            <span class="text-brand-black/30 text-xl font-bold uppercase">/</span>
            <button class="text-brand-black/30 text-xl font-bold uppercase hover:text-brand-pink transition-colors cursor-pointer">
            FR
            </button>
        </li>
    </ul>
</aside>

<style>
    /* --- Header Load Animations --- */
    .header-animate-down {
        opacity: 0;
        animation: fadeDown 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Stagger delays for header items */
    .header-delay-150 { animation-delay: 150ms; }
    .header-delay-200 { animation-delay: 200ms; }

    @keyframes fadeDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* --- Menu Link Staggered Animations --- */
    .mobile-link {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
                    transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* When the panel gets the 'is-open' class via JS, animate the links in */
    #mobile-panel.is-open .mobile-link {
        opacity: 1;
        transform: translateY(0);
    }

    /* Stagger the links appearing */
    #mobile-panel.is-open .mobile-link:nth-child(1) { transition-delay: 400ms; }
    #mobile-panel.is-open .mobile-link:nth-child(2) { transition-delay: 450ms; }
    #mobile-panel.is-open .mobile-link:nth-child(3) { transition-delay: 500ms; }
    #mobile-panel.is-open .mobile-link:nth-child(4) { transition-delay: 550ms; }
    #mobile-panel.is-open .mobile-link:nth-child(5) { transition-delay: 600ms; }
    #mobile-panel.is-open .mobile-link:nth-child(6) { transition-delay: 650ms; }
</style>

<!-- JavaScript to handle toggling -->
<script>
    document.addEventListener('astro:page-load', () => {
        // Add the '!' at the end of each getElementById to satisfy TypeScript
        const menuBtn = document.getElementById('mobile-menu-button')!;
        const mobilePanel = document.getElementById('mobile-panel')!;
        const overlay = document.getElementById('mobile-overlay')!;

        // Safety check to ensure elements exist on the current page
        if (!menuBtn || !overlay || !mobilePanel) return;

        let isOpen = false;

        function toggleMenu() {
            isOpen = !isOpen;

            // Change button text based on state
            menuBtn.textContent = isOpen ? 'Close' : 'Menu';
            
            // Slide the panel in/out (Using -translate-x-full for left-side slide)
            mobilePanel.classList.toggle('-translate-x-full');
            
            // Toggle 'is-open' to trigger the staggered CSS animations
            mobilePanel.classList.toggle('is-open');
            
            // Fade the overlay in/out
            overlay.classList.toggle('opacity-0');
            overlay.classList.toggle('pointer-events-none');
        }

        // Add click events to both the button and the dark overlay
        menuBtn.addEventListener('click', toggleMenu);
        overlay.addEventListener('click', toggleMenu);
    });
</script>