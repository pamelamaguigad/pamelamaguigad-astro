---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Pamela Maguigad</title>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-brand-cream font-syne">

		<!-- Required div for overflow on iOS -->
    	<div class="w-full min-h-svh flex flex-col items-center overflow-x-hidden relative">

			<div class="w-[3249px] h-[781px] left-[-200px] top-[-360px] absolute">
				<img 
					src="/assets/brand-background-overlay.svg" 
				/>
			</div>

			<Header />

			<main class="w-full flex flex-col items-center">
				<slot /> 
			</main>

			<Footer />

		</div>

	</body>
</html>
