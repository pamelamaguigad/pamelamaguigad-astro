---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Font } from 'astro:assets';
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Pamela Maguigad</title>

		<!-- Favicons -->
		<link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
		<link rel="icon" type="image/x-icon" href="/favicons/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
		<link rel="manifest" href="/favicons/site.webmanifest" />

		<Font cssVariable="--font-rousie" preload />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

	</head>
	<body class="bg-brand-cream font-syne">

		<!-- Required div for overflow on iOS -->
    	<div class="w-full min-h-svh flex flex-col items-center overflow-x-hidden relative">

			<div class="w-[3249px] h-[781px] left-[-200px] top-[-360px] absolute z-20 pointer-events-none">
				<img 
					src="/assets/brand-background-overlay.svg" 
				/>
			</div>

			<Header />

            <!-- Use grow to push footer to the bottom of the viewport -->
			<main class="w-full flex flex-col grow items-center">
				<slot /> 
			</main>

			<Footer />

		</div>

	</body>
</html>